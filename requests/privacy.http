@baseUrl = http://localhost:9377
# 로컬 서버 환경변수의 공유 키. 실제 값을 이 파일에 커밋하지 않는다.
@bffKey = {{$processEnv BFF_INTERNAL_KEY}}
@accessToken = {{socialLogin.response.body.$.data.accessToken}}

# 로그인: user 101 (phone 01011112222 / Test1234!)
# 행이 없으면 privateAccount=false, feedVisibility=PUBLIC, storyVisibility=NEIGHBORS, 나머지 true

### 0. 소셜 로그인 (시드 user 101)
# @name socialLogin
POST {{baseUrl}}/api/v1/auth/login
X-BFF-Key: {{bffKey}}
Content-Type: application/json

{
  "phone": "01011112222",
  "password": "Test1234!"
}

### 1. 공개 범위 조회
GET {{baseUrl}}/api/v1/settings/privacy
X-BFF-Key: {{bffKey}}
Authorization: Bearer {{accessToken}}

### 2. 공개 범위 변경 (넣은 필드만)
PATCH {{baseUrl}}/api/v1/settings/privacy
X-BFF-Key: {{bffKey}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "privateAccount": true,
  "storyVisibility": "NEIGHBORS"
}

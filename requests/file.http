@baseUrl = http://localhost:9377
# 로컬 서버 환경변수의 공유 키. 실제 값을 이 파일에 커밋하지 않는다.
@bffKey = {{$processEnv BFF_INTERNAL_KEY}}
@accessToken = {{socialLogin.response.body.$.data.accessToken}}
@fileId = {{uploadImage.response.body.$.data.fileId}}

# 업로드 전용 테스트 유저 (시드와 무관).
# CDN 시드 file_id: 110~114 프로필 / 120~124 포스트 / 130~133 스토리 / 140~141 상품
# 피드·스토리 등: 시드 로그인(phone 01011112222 / Test1234!) + 위 fileId (file_path=CDN 절대 URL)

### 0. 소셜 로그인 (토큰 확보)
# @name socialLogin
POST {{baseUrl}}/api/v1/auth/login
X-BFF-Key: {{bffKey}}
Content-Type: application/json

{
  "phone": "01011112222",
  "password": "Test1234!"
}

### 1. 이미지 업로드 (AUTO, purpose=FEED)
# POST /api/v1/files · FileController.upload · mediaType=AUTO · purpose=FEED|STORY|PET|TAG (기본 FEED)
# 저장 경로: images/{purpose}/uuid.ext 또는 videos/{purpose}/uuid.ext (uploadDir 하위)
# @name uploadImage
POST {{baseUrl}}/api/v1/files
X-BFF-Key: {{bffKey}}
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="sample.jpg"
Content-Type: image/jpeg

< ./fixtures/sample.jpg
--WebAppBoundary
Content-Disposition: form-data; name="mediaType"

AUTO
--WebAppBoundary
Content-Disposition: form-data; name="purpose"

FEED
--WebAppBoundary--

### 2. 이미지 업로드 (mediaType=IMAGE, purpose=PET)
# POST /api/v1/files · mediaType=IMAGE · purpose=PET → images/pet/{uuid}.ext
POST {{baseUrl}}/api/v1/files
X-BFF-Key: {{bffKey}}
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="sample.png"
Content-Type: image/png

< ./fixtures/sample.png
--WebAppBoundary
Content-Disposition: form-data; name="mediaType"

IMAGE
--WebAppBoundary
Content-Disposition: form-data; name="purpose"

PET
--WebAppBoundary--

### 3. 영상 업로드 (mediaType=VIDEO, purpose=STORY)
# POST /api/v1/files · mediaType=VIDEO · purpose=STORY → videos/story/{uuid}.ext
# @name uploadVideo
POST {{baseUrl}}/api/v1/files
X-BFF-Key: {{bffKey}}
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="sample.mp4"
Content-Type: video/mp4

< ./fixtures/sample.mp4
--WebAppBoundary
Content-Disposition: form-data; name="mediaType"

VIDEO
--WebAppBoundary
Content-Disposition: form-data; name="purpose"

STORY
--WebAppBoundary--

### 4. 메타 조회
# (= 7번과 동일 API) GET /api/v1/files/{fileId}
GET {{baseUrl}}/api/v1/files/{{fileId}}
X-BFF-Key: {{bffKey}}
Authorization: Bearer {{accessToken}}

### 5. 바이너리 조회
GET {{baseUrl}}/api/v1/files/{{fileId}}/content
X-BFF-Key: {{bffKey}}
Authorization: Bearer {{accessToken}}

### 6. 소프트 삭제
DELETE {{baseUrl}}/api/v1/files/{{fileId}}
X-BFF-Key: {{bffKey}}
Authorization: Bearer {{accessToken}}

### 7. 삭제 후 메타 조회 (404 예상)
# (= 4번과 동일 API) GET /api/v1/files/{fileId}
GET {{baseUrl}}/api/v1/files/{{fileId}}
X-BFF-Key: {{bffKey}}
Authorization: Bearer {{accessToken}}

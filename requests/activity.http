@baseUrl = http://localhost:9377
# 로컬 서버 환경변수의 공유 키. 실제 값을 이 파일에 커밋하지 않는다.
@bffKey = {{$processEnv BFF_INTERNAL_KEY}}
@accessToken = {{socialLogin.response.body.$.data.accessToken}}

# 로그인: user 101 (phone 01011112222 / Test1234!)
# 내가 한 일만. 최신순. limit 기본 30, 최대 50.

### 0. 소셜 로그인 (시드 user 101)
# @name socialLogin
POST {{baseUrl}}/api/v1/auth/login
X-BFF-Key: {{bffKey}}
Content-Type: application/json

{
  "phone": "01011112222",
  "password": "Test1234!"
}

### 1. 내 활동
# type: FEED_LIKE | COMMENT_LIKE | REPLY_LIKE | FEED_COMMENT | FEED_REPLY | NEIGHBOR_REQUEST | FEED | STORY
# 시각은 occurredAt. 미리보기는 snippet. 취소는 neighborStatus=PENDING 일 때 DELETE /neighbors/{neighborId}
GET {{baseUrl}}/api/v1/settings/activities?limit=30
X-BFF-Key: {{bffKey}}
Authorization: Bearer {{accessToken}}

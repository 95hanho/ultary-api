@baseUrl = http://localhost:9377
# 로컬 서버 환경변수의 공유 키. 실제 값을 이 파일에 커밋하지 않는다.
@bffKey = {{$processEnv BFF_INTERNAL_KEY}}
@accessToken = {{socialLogin.response.body.$.data.accessToken}}

# 로그인: user 101
# 소켓은 BFF를 거치지 않는다. ws://localhost:9377/api/v1/ws
# 연결 직후 첫 텍스트: {"type":"AUTH","ticket":"<아래 ticket>"}
# 성공하면 {"type":"AUTH_OK"} 다음에 {"type":"NOTIFICATION_UNREAD","unreadCount":N}
# 새 DM: {"type":"DM_MESSAGE","dmRoomId","room","message"}  message.fromMe 는 받는 사람 기준
# 읽음: 상대에게만 {"type":"DM_READ","dmRoomId","lastReadMessageId"}
# 입력 중: 상대에게만 {"type":"DM_TYPING","dmRoomId","userNo","typing"}
# 25초마다 {"type":"PING"}

### 0. 소셜 로그인 (시드 user 101)
# @name socialLogin
POST {{baseUrl}}/api/v1/auth/login
X-BFF-Key: {{bffKey}}
Content-Type: application/json

{
  "phone": "01011112222",
  "password": "Test1234!"
}

### 1. 입장 토큰 (30초, 한 번)
# @name wsTicket
POST {{baseUrl}}/api/v1/ws/ticket
X-BFF-Key: {{bffKey}}
Authorization: Bearer {{accessToken}}

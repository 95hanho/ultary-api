{
  "version": "2026-09-18",
  "note": "FE/BFF는 이 파일을 복사해 사용. Spring *Rules.java와 동기화 유지.",
  "nickname": {
    "charRegex": "^[A-Za-z가-힣]+$",
    "hangulOnly": { "min": 2, "max": 5 },
    "englishOnly": { "min": 4, "max": 10 },
    "mixed": {
      "hangulWeight": 2,
      "englishWeight": 1,
      "weightedMin": 4,
      "weightedMax": 10,
      "hangulMax": 5
    },
    "cooldownDays": 7,
    "message": "닉네임은 한글 2~5자 또는 영문 4~10자입니다. 혼합 시 한글 1자는 2자로 계산하며 합계 10자를 넘을 수 없습니다."
  },
  "password": {
    "regex": "^(?=.*[A-Za-z])(?=.*\\d)(?=.*[!@#$%^&*()_+\\-={}\\[\\]|;:'\",.<>/?~`\\\\]).{8,100}$",
    "minLength": 8,
    "maxLength": 100,
    "message": "비밀번호는 8자 이상이며 영문, 숫자, 특수문자를 각각 1자 이상 포함해야 합니다."
  },
  "phone": {
    "storedRegex": "^01[0-9]{8,9}$",
    "normalize": "trim → 비숫자 제거 → +82/82(뒤가 1로 시작)이면 0으로 치환",
    "examples": {
      "ok": ["01011112222", "010-1111-2222", "+82 10-1111-2222"],
      "failLogin": ["1011112222"]
    },
    "message": "휴대폰 번호 형식이 올바르지 않습니다. (예: 01012345678)"
  },
  "handle": {
    "appliesTo": ["pet.mention_id", "tag.handle"],
    "regex": "^[A-Za-z0-9_]{1,30}$",
    "cooldownDays": 30,
    "handleFirstSetFreeIfNullChangedAt": true,
    "message": "핸들은 영문, 숫자, 언더바(_)만 사용할 수 있습니다. (1~30자)"
  },
  "hashtag": {
    "regex": "^[A-Za-z0-9가-힣_]{1,30}$",
    "normalize": "앞 # 제거 후 trim",
    "immutableAfterCreate": true,
    "message": "해시태그는 영문, 숫자, 한글, 언더바(_)만 사용할 수 있습니다. (1~30자, # 제외)"
  },
  "signupFields": {
    "phoneAuthCompleteToken": { "required": true },
    "password": { "required": true, "rule": "password" },
    "nickname": { "required": true, "rule": "nickname" },
    "name": { "required": false, "maxLength": 20 },
    "email": { "required": false, "maxLength": 50 }
  }
}
